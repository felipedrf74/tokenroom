// Versions. The Mac collector is versioned on its own.
// scripts/build.sh reads these for the swiftc fallback.
// Mac 2.6.3 build 1 follows released 2.6.2 with the direct read (docs/usage-direct-read-20261116.md).
// Mobile 1.3.5 build 1 follows 1.3.4 build 1, uploaded on 15 November, with the direct read (docs/usage-direct-read-20261116.md).
TOKENROOM_MAC_VERSION = 2.6.3
TOKENROOM_MAC_BUILD = 1

// iPhone app, widgets, and Watch app share one version.
TOKENROOM_MOBILE_VERSION = 1.3.5
TOKENROOM_MOBILE_BUILD = 1
