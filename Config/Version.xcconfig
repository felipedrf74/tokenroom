// Versions. The Mac collector is versioned on its own.
// scripts/build.sh reads these for the swiftc fallback.
// Mac 2.5.3 build 1 includes the Grok Bot connection fix and selectable popover styles.
// Mobile 1.2.2 build 1 follows the published 1.2.1: the same fixes.
TOKENROOM_MAC_VERSION = 2.5.3
TOKENROOM_MAC_BUILD = 1

// iPhone app, widgets, and Watch app share one version.
TOKENROOM_MOBILE_VERSION = 1.2.2
TOKENROOM_MOBILE_BUILD = 1
