// Versions. The Mac collector is versioned on its own.
// scripts/build.sh reads these for the swiftc fallback.
// Mac 2.5.1 build 1 follows the published 2.5.0: level-coloured meters and fresher iPhone readings.
// Mobile 1.2.1 build 1 follows the published 1.2.0: the same finish and a Usage tab that stays current.
TOKENROOM_MAC_VERSION = 2.5.1
TOKENROOM_MAC_BUILD = 1

// iPhone app, widgets, and Watch app share one version.
TOKENROOM_MOBILE_VERSION = 1.2.1
TOKENROOM_MOBILE_BUILD = 1
